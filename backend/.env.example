# ============================================
# Paris Janitor — Backend
# ============================================
# Copie ce fichier en .env et remplis les valeurs

# Environnement
NODE_ENV=production
PORT=10000

# MongoDB (obligatoire)
# Va sur https://www.mongodb.com/atlas pour créer un cluster gratuit
# puis récupère ton URI de connexion
MONGO_URI=mongodb+srv://ton_user:ton_mot_de_passe@cluster.mongodb.net/ParisJanitor?retryWrites=true&w=majority

# JWT — génère une clé complexe avec : openssl rand -hex 32
JWT_SECRET=remplace_par_une_cle_secrete_complexe

# Stripe (mode test ou production)
STRIPE_SECRET=sk_test_...        # sk_live_... en production
STRIPE_WEBHOOK_SECRET=whsec_...  # depuis le dashboard Stripe

# CORS — les URLs autorisées (séparées par des virgules)
# En local : http://localhost:5173
# Sur Vercel : https://ton-projet.vercel.app
CORS_ORIGIN=http://localhost:5173,https://ton-projet.vercel.app

# MinIO / S3 (optionnel — pour stocker les factures PDF)
# Si tu n'as pas de MinIO, les factures seront générées en mémoire
MINIO_ENDPOINT=s3.amazonaws.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=ton_access_key
MINIO_SECRET_KEY=ton_secret_key
MINIO_BUCKET=paris-janitor-factures
